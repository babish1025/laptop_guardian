# ==============================================================================
# LAPTOP GUARDIAN — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your actual deployment credentials.
# NEVER commit the active .env or service account keys to version control!
# ==============================================================================

# ── 1. DATABASE CONFIGURATION (MySQL) ─────────────────────────────────────────
# LOCAL DEVELOPMENT (XAMPP / Local MySQL):
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=laptop_guardian

# CLOUD PRODUCTION (e.g. Railway, Render, PlanetScale, AWS RDS, Aiven):
# DB_HOST=containers-us-west-XXX.railway.app
# DB_PORT=6543
# DB_USER=root
# DB_PASSWORD=your_secure_cloud_db_password
# DB_NAME=railway
# DB_POOL_SIZE=10
# DB_SSL=required
# DB_SSL_CA=/path/to/ca-cert.pem

# ── 2. FLASK SERVER (Cloud or Local) ──────────────────────────────────────────
# Secret key for sessions/cookies. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_a_random_32_character_secret_key_here
FLASK_ENV=production
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Public WAN URL of the deployed Cloud Backend API (e.g. Railway / Render / VPS)
PUBLIC_BASE_URL=https://your-backend-app.up.railway.app

# Cross-Origin Resource Sharing (CORS):
# Comma-separated list of allowed origins. Use * or leave blank for development only.
CORS_ORIGINS=https://your-frontend-app.com,https://your-backend-app.up.railway.app

# ── 3. LAPTOP MONITORING & WATCHDOG TIMERS ────────────────────────────────────
# Heartbeat interval (seconds): How often the laptop agent posts telemetry
HEARTBEAT_INTERVAL=30

# Backend offline detection timeout (seconds):
# If no heartbeat is received within this duration, the cloud backend marks the laptop OFFLINE.
# Must be greater than HEARTBEAT_INTERVAL (e.g., 90s allows 3 missed heartbeats before alerting).
OFFLINE_TIMEOUT=90

# Watchdog scanner frequency (seconds):
WATCHDOG_CHECK_INTERVAL=15

# Remote commands polling frequency (seconds) and expiration:
COMMAND_POLL_INTERVAL=10
COMMAND_EXPIRY_MINUTES=5

# ── 4. LAPTOP AGENT & CLIENT CONNECTION ───────────────────────────────────────
# LOCAL DEVELOPMENT:
# BACKEND_URL=http://127.0.0.1:5000

# CLOUD WAN PRODUCTION (Public HTTPS domain where the Flask backend is hosted):
BACKEND_URL=https://your-backend-app.up.railway.app

# ── 5. FIREBASE CLOUD MESSAGING (PUSH NOTIFICATIONS) ──────────────────────────
# Recommended (HTTP v1 API): Path to downloaded Firebase Service Account JSON file
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json

# Alternatively (for cloud hosts like Railway/Render where mounting files is difficult):
# Paste the raw contents of serviceAccountKey.json as a single-line JSON string:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-proj",...}

# Legacy FCM Server Key fallback (optional, legacy only):
FCM_SERVER_KEY=
